<section class="bibliosoph-injury-page-fields bibliosoph-injury-page-edit">
    <div class="injury-edit-section-header">
        <i class="fa-solid fa-user-injured"></i>
        <span>Injury</span>
    </div>

    {{#if warnings.length}}
        <div class="injury-edit-warnings">
            {{#each warnings}}
                <p><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>
            {{/each}}
        </div>
    {{/if}}

    <p class="injury-edit-hint">The page title is the injury's name. These fields drive the chat card and the effect applied to the token.</p>

    <div class="injury-edit-grid">
        <div class="form-group">
            <label for="{{document.id}}-injury-category">Damage Type</label>
            <select id="{{document.id}}-injury-category" name="system.category">
                {{#each categoryChoices}}
                    <option value="{{this.value}}" {{#if (eq this.value ../system.category)}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
            </select>
        </div>
        <div class="form-group">
            <label for="{{document.id}}-injury-severity">Severity</label>
            <select id="{{document.id}}-injury-severity" name="system.severity">
                {{#each severityChoices}}
                    <option value="{{this.value}}" {{#if (eq this.value ../system.severity)}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
            </select>
        </div>
    </div>

    <div class="form-group injury-edit-full">
        <label for="{{document.id}}-injury-image">Image</label>
        <file-picker id="{{document.id}}-injury-image" name="system.image" type="image" value="{{system.image}}"
            placeholder="icons/skills/wounds/injury-pain-body-orange.webp"></file-picker>
    </div>

    <div class="form-group injury-edit-full">
        <label for="{{document.id}}-injury-imagetitle">Caption</label>
        <input type="text" id="{{document.id}}-injury-imagetitle" name="system.imagetitle" value="{{system.imagetitle}}"
            placeholder="A short evocative line shown under the art">
    </div>

    <div class="form-group injury-edit-full">
        <label for="{{document.id}}-injury-description">Description</label>
        <textarea id="{{document.id}}-injury-description" name="system.description" rows="5"
            placeholder="What the character experiences, in second person. Three to five sentences.">{{system.description}}</textarea>
    </div>

    <div class="form-group injury-edit-full">
        <label for="{{document.id}}-injury-treatment">Treatment</label>
        <textarea id="{{document.id}}-injury-treatment" name="system.treatment" rows="3"
            placeholder="How a healer would tend it. This is the GM's adjudication text.">{{system.treatment}}</textarea>
    </div>

    <div class="injury-edit-section-header">
        <i class="fa-solid fa-gears"></i>
        <span>Mechanics</span>
    </div>

    <div class="injury-edit-grid">
        <div class="form-group">
            <label for="{{document.id}}-injury-damage">Damage (% of max HP, one time)</label>
            <input type="number" id="{{document.id}}-injury-damage" name="system.damage" value="{{system.damage}}" min="0" max="100" step="1"
                title="A share of maximum hit points, so the wound means the same thing at level 1 and level 15. Floored so it can never drop a character below 1 HP.">
        </div>
        <div class="form-group">
            <label for="{{document.id}}-injury-duration">Duration (seconds, 0 = permanent)</label>
            <input type="number" id="{{document.id}}-injury-duration" name="system.duration" value="{{system.duration}}" min="0" step="30">
        </div>
        <div class="form-group">
            <label for="{{document.id}}-injury-status">Condition</label>
            <select id="{{document.id}}-injury-status" name="system.statuseffect">
                {{#each conditionChoices}}
                    <option value="{{this.value}}" {{#if (eq this.value ../system.statuseffect)}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
            </select>
        </div>
        <div class="form-group">
            <label for="{{document.id}}-injury-tick">Recurring damage (% of max HP per turn)</label>
            <input type="number" id="{{document.id}}-injury-tick" name="system.tick" value="{{system.tick}}" min="0" max="100" step="1"
                title="Lost at the start of the victim's turn, for as long as the injury lasts. 0 for most injuries — this is for wounds that keep bleeding.">
        </div>
        <div class="form-group">
            <label for="{{document.id}}-injury-expiry">When the duration ends</label>
            <select id="{{document.id}}-injury-expiry" name="system.expiry">
                {{#each expiryChoices}}
                    <option value="{{this.value}}" {{#if (eq this.value ../system.expiry)}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
            </select>
        </div>
        <div class="form-group">
            <label for="{{document.id}}-injury-flavor">Flavour status (no mechanics)</label>
            <input type="text" id="{{document.id}}-injury-flavor" name="system.flavor" value="{{system.flavor}}"
                placeholder="Confused, Clumsy Fingers…"
                title="Shown on the card when there is no real condition. Applies nothing — a real condition always wins.">
        </div>
        <div class="form-group">
            <label for="{{document.id}}-injury-odds">Odds (1–100, higher is commoner)</label>
            <input type="number" id="{{document.id}}-injury-odds" name="system.odds" value="{{system.odds}}" min="1" max="100" step="1">
        </div>
        <div class="form-group">
            <label for="{{document.id}}-injury-dc">Treatment DC <span class="injury-edit-note">(blank = {{treatmentDC}} from severity)</span></label>
            <input type="number" id="{{document.id}}-injury-dc" name="system.treatmentdc" value="{{system.treatmentdc}}" min="1" step="1" placeholder="{{treatmentDC}}">
        </div>
    </div>

    <div class="injury-edit-section-header">
        <i class="fa-solid fa-dice-d20"></i>
        <span>Modifiers</span>
    </div>
    <p class="injury-edit-hint">Real penalties applied while the injury lasts — "-2 to attack rolls". Leave rounds at 0 and it lasts as long as the injury does, which is the norm: a broken arm hinders you until it is treated. Clear a row's stat to delete it.</p>

    <div class="injury-edit-modifiers">
        {{#each modifierRows}}
            <div class="injury-modifier-row">
                <select name="system.modifiers.{{@index}}.stat">
                    <option value="">—</option>
                    {{#each ../statChoices}}
                        <option value="{{this.value}}" {{#if (eq this.value ../this.stat)}}selected{{/if}}>{{this.label}}</option>
                    {{/each}}
                </select>
                <input type="number" name="system.modifiers.{{@index}}.value" value="{{this.value}}" step="1" placeholder="-2" title="Bonus or penalty">
                <input type="number" name="system.modifiers.{{@index}}.rounds" value="{{this.rounds}}" min="0" step="1" placeholder="rounds" title="0 = as long as the injury lasts">
            </div>
        {{/each}}
    </div>

    <div class="injury-edit-section-header">
        <i class="fa-solid fa-masks-theater"></i>
        <span>Running This Injury</span>
    </div>
    <div class="form-group injury-edit-full">
        <textarea id="{{document.id}}-injury-gmnotes" name="system.gmnotes" rows="5"
            placeholder="How to run it at the table: what it costs in combat or movement, what to rule on, and a stinger or two to drop in — &quot;he's leaving a trail of blood; that's not going to go well.&quot;">{{system.gmnotes}}</textarea>
        <p class="injury-edit-hint">Ships with the injury and updates when it does.</p>
    </div>

    <!-- Blacksmith's shared GM Notes area: the GM's own note plus our
         contributed section. Their component owns everything inside. -->
    <section class="bibliosoph-gm-notes-host" data-gm-notes-host aria-label="GM Notes"></section>

    <div class="injury-edit-section-header">
        <i class="fa-solid fa-scroll"></i>
        <span>Extended Description</span>
    </div>
    <p class="injury-edit-hint">Optional rich text shown on this page below the fields. Visible to anyone who can read the page.</p>
</section>

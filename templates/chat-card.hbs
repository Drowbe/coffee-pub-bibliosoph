<span style="visibility: hidden">coffeepub-hide-header</span>
<div class="blacksmith-card {{theme}}" >
    <div class="card-header">
        <i class="fa-solid {{iconStyle}}"></i>{{cardTitle}}
    </div>

    {{#if isEncounterCard}}
    <!-- ENCOUNTER CARD: narrative (no encounter / intro / reveal) -->
    {{#if userName}}
        <div class="container-user">
            <img class="token-image" src="{{userAvatar}}" alt="" />
            <div class="token-text-wrapper">
                <span class="token-name">{{userName}}</span>
                {{#if characterName}}<span class="token-character">{{characterName}}</span>{{/if}}
            </div>
        </div>
    {{/if}}

    {{#if narrativeImage}}
        <img class="encounter-narrative-image" src="{{narrativeImage}}" alt="" />
    {{/if}}
    {{#if narrativeTitle}}
        <div class="section-header encounter-narrative-title">
            {{{narrativeIcon}}} {{narrativeTitle}}
        </div>
    {{/if}}
    {{#if narrativeDescription}}
        <p class="encounter-narrative-description">{{narrativeDescription}}</p>
    {{/if}}
    {{#if encounterMonsters}}
        <div class="section-header"><i class="fa-solid fa-dragon"></i> Adversaries</div>
        {{#if detectionNarrativeText}}
            <p class="encounter-detection-narrative"><strong>{{detectionLevelHeader}}</strong>: {{detectionNarrativeText}}</p>
        {{/if}}
        <div class="bibliosoph-encounter-adversaries" data-encounter-detection="{{encounterDetectionLevel}}">
            <div class="encounter-adversaries-gm-view">
                <div class="encounter-monsters">
                    {{#each encounterMonsters}}
                        <div class="encounter-monster-row">
                            {{#if img}}<img class="encounter-monster-img" src="{{img}}" alt="" data-tooltip="CR {{cr}}" />{{/if}}
                            <span class="encounter-monster-name">{{{displayNameLink}}}</span>
                        </div>
                    {{/each}}
                </div>
            </div>
            <div class="encounter-adversaries-player-view" style="display:none">
                {{#if encounterShowUnknownAdversaries}}
                    <div class="encounter-monsters">
                        <div class="encounter-monster-row">
                            <img class="encounter-monster-img" src="{{encounterUnknownAdversariesImage}}" alt="" />
                            <span class="encounter-monster-name">Unknown Adversaries</span>
                        </div>
                    </div>
                {{else}}
                    <div class="encounter-monsters">
                        {{#each encounterMonstersPlain}}
                            <div class="encounter-monster-row encounter-monster-row-plain">
                                {{#if img}}<img class="encounter-monster-img" src="{{img}}" alt="" />{{/if}}
                                <span class="encounter-monster-name">{{displayName}}</span>
                            </div>
                        {{/each}}
                    </div>
                {{/if}}
            </div>
        </div>
    {{/if}}
    {{else if isInvestigationCard}}
    <!-- INVESTIGATION CARD: narrative + item rows + inventory summary -->
    {{#if userName}}
        <div class="container-user">
            <img class="token-image" src="{{userAvatar}}" alt="" />
            <div class="token-text-wrapper">
                <span class="token-name">{{userName}}</span>
                {{#if characterName}}<span class="token-character">{{characterName}}</span>{{/if}}
            </div>
        </div>
    {{/if}}
    {{#if narrativeTitle}}
        <div class="section-header investigation-narrative-title">
            {{{narrativeIcon}}} {{narrativeTitle}}
        </div>
    {{/if}}
    {{#if narrativeDescription}}
        <p class="investigation-narrative-description">{{narrativeDescription}}</p>
    {{/if}}
    {{#if coinsFound}}
        <div class="section-header"><i class="fa-solid fa-coins"></i> Coins</div>
        <p class="investigation-coins">{{coinsDisplayLine}}</p>
    {{/if}}
    {{#if itemsByRarity}}
        {{#each itemsByRarity}}
            <div class="section-header"><i class="fa-solid {{icon}}"></i> {{rarity}}</div>
            <div class="investigation-items">
                {{#each items}}
                    <div class="investigation-item-row">
                        {{#if img}}<img class="investigation-item-img" src="{{img}}" alt="" />{{/if}}
                        <span class="investigation-item-name">{{{link}}}</span>
                    </div>
                {{/each}}
            </div>
        {{/each}}
    {{/if}}
    {{#if (or inventorySummaryLine coinsSummaryLine)}}
        <div class="section-content section-dark">
            {{#if inventorySummaryLine}}
                <p><i class="fa-solid fa-bag-shopping"></i> {{inventorySummaryLine}}</p>
            {{/if}}
            {{#if coinsSummaryLine}}
                <p><i class="fa-solid fa-coins"></i> {{coinsSummaryLine}}</p>
            {{/if}}
        </div>
    {{/if}}
    {{else}}
    <!-- STANDARD CARD (Encounter, Crit, etc.) -->
    <!-- SENDER -->
    {{#if userName}}
        <div class="container-user">
            {{#if portraitBlood}}
                <span style="position: relative; display: inline-block; flex: 0 0 auto; line-height: 0;">
                    <img class="token-image" src="{{userAvatar}}" alt="" style="display: block;" />
                    <img class="token-image" src="{{portraitBlood}}" alt="" aria-hidden="true" style="position: absolute; top: 0; left: 0; margin: 0; pointer-events: none;" />
                </span>
            {{else}}
                <img class="token-image" src="{{userAvatar}}" alt="" />
            {{/if}}
            <div class="token-text-wrapper">
                <span class="token-name">{{userName}}</span>
                {{#if characterName}}<span class="token-character">{{characterName}}</span>{{/if}}
            </div>
        </div>
    {{/if}}

    <!-- PRIVATE MESSAGE RECIPIENTS -->
    {{#if arrPrivateRecipients}}
        {{#if privateRecipientsCompressed}}
            <div class="container-user">
                {{#each arrPrivateRecipients}}
                    <img class="token-image" src="{{playerAvatar}}" title="{{playerName}}" alt="" />
                {{/each}}
            </div>
        {{else}}
            {{#each arrPrivateRecipients}}
                <div class="container-user">
                    <img class="token-image" src="{{playerAvatar}}" alt="" />
                    <div class="token-text-wrapper">
                        <span class="token-name">{{playerName}}</span>
                        {{#if characterName}}<br />
                        <span class="token-character">{{characterName}}</span>{{/if}}
                    </div>
                </div>
            {{/each}}
        {{/if}}
    {{/if}}

    <!-- MAIN CONTENT - only show section when it has content -->
    {{#if (or banner cardSubTitle image injurycategory content descriptionReveal descriptionBefore descriptionAfter)}}
    <div class="section-content">

        <!-- BANNER IMAGE -->
        {{#if banner}}
            <img style="width: 100%;" src="{{banner}}" />
        {{/if}}

        <!-- CARD SUBTITLE -->
        {{#if cardSubTitle}}
            <div class="section-header">
                <i class="fa-solid {{iconSubStyle}}"></i>{{cardSubTitle}}
            </div>
        {{/if}}

        <!-- LARGE IMAGE -->
        {{#if image}}
            <img class="token-background-{{imageBackground}}" style="width: 100%;" src="{{image}}" alt="" />
            {{#if imagecaption}}
                <p style="margin: 2px 0 0 0; text-align: center; font-style: italic; font-size: 0.9em; opacity: 0.75;">{{imagecaption}}</p>
            {{/if}}
        {{/if}}

        {{#if injurycategory}}
            <div class="section-header">
                <i class="fa-solid {{injurycategoryicon}}"></i>{{injurycategory}}
            </div>
        {{/if}}


        <!-- TREATMENT OUTCOME: [healer] [icon] [patient] strip. Grid keeps
             the icon dead-centre even when there is no healer portrait
             (self-treatment); the affliction icon badges the patient. -->
        {{#if treatoutcome}}
            <div style="display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px; margin: 6px 0 16px 0;">
                <span style="justify-self: end; line-height: 0;">
                    {{#if treatoutcome.healerImg}}<img src="{{treatoutcome.healerImg}}" alt="" data-tooltip="{{treatoutcome.healerName}}" style="width: 56px; height: 56px; object-fit: cover; border-radius: 6px; border: 1px solid rgba(0,0,0,0.25); display: block;" />{{/if}}
                </span>
                <i class="fa-solid {{treatoutcome.icon}}" style="font-size: 2em; opacity: 0.85; justify-self: center;"></i>
                <span style="justify-self: start; position: relative; line-height: 0;">
                    <img src="{{treatoutcome.patientImg}}" alt="" data-tooltip="{{treatoutcome.patientName}}" style="width: 56px; height: 56px; object-fit: cover; border-radius: 6px; border: 1px solid rgba(0,0,0,0.25); display: block;" />
                    {{#if treatoutcome.afflictionImg}}
                        <img src="{{treatoutcome.afflictionImg}}" alt="" data-tooltip="{{treatoutcome.afflictionName}}" style="position: absolute; right: -8px; bottom: -8px; width: 26px; height: 26px; object-fit: cover; border-radius: 4px; border: 1px solid rgba(0,0,0,0.35); background: rgba(0,0,0,0.5); margin: 0;" />
                    {{/if}}
                </span>
            </div>
        {{/if}}

        <!-- CARD CONTENT -->
        {{#if (or content descriptionReveal descriptionBefore descriptionAfter)}}

            <!-- CONTENT TITLE -->
            {{#if title}}
                <div class="section-header">
                    <i class="fa-solid fa-dice"></i> {{title}}
                </div>
            {{/if}}
            <!-- CHECK-UP: HEALTH BAR (Crier turn-card styling) -->
            {{#if hpBar}}
                <div title="{{hpBar.label}}" style="border-radius: 4px; padding: 3px; margin-bottom: 8px; background-color: rgba(0,0,0,0.1);">
                    <div style="height: 10px; border-radius: 2px; width: {{hpBar.percent}}%; background: {{hpBar.color}};"></div>
                </div>
            {{/if}}
            <!-- CONTENT - NORMAL -->
            {{#if content}}
                <p>{{{content}}}</p>
            {{/if}}
            <!-- CONTENT - SEARCH -->
            <p>
                {{#if descriptionBefore}}{{descriptionBefore}} {{/if}}
                {{#if descriptionReveal}}{{descriptionReveal}} <strong>{{quantityword}} {{title}}</strong>{{/if}}
            </p>
            <!-- {{#if descriptionAfter}}<p>{{descriptionAfter}}</p>{{/if}} -->
        {{/if}}
    </div>
    {{/if}}

    <!-- DARK SECTION - only show when it has content -->
    {{#if (or treatment duration link kind rarity value details inventoryAddedMessage)}}
    <div class="section-content section-dark">

        <!-- INJURY TREATMENT -->
        {{#if treatment}}
            <p><i class="fa-solid fa-heart-pulse"></i><strong>Treatment</strong>: {{treatment}}</p>
        {{/if}}

        <!-- INJURY DETAILS -->
        {{#if duration}}
            <p><i class="fa-solid fa-hourglass-half"></i><strong>{{duration}}</strong></p>
            <p><i class="fa-solid fa-heart-crack"></i><strong>{{damage}}</strong></p>
            <p><i class="fa-solid fa-sparkles"></i><strong>{{statuseffect}}</strong></p>
        {{/if}}

        <!-- INVESTIGATION: added to inventory message and/or compendium link -->
        {{#if inventoryAddedMessage}}
            <p><i class="fa-solid fa-bag-shopping"></i> {{inventoryAddedMessage}}</p>
        {{/if}}
        {{#if link}}
            <p>{{link}} x <strong>{{quantitynum}}</strong></p>
        {{/if}}

        <!-- RARITY -->
        {{#if (or kind rarity value details)}}
            <div>
                <h2>Additional Details</h2>
                <ul>
                    {{#if kind}}<li><strong>Type:</strong> {{kind}}</li>{{/if}}
                    {{#if rarity}}<li><strong>Rarity:</strong> {{rarity}}</li>{{/if}}
                    {{#if value}}<li><strong>Value:</strong> {{value}}</li>{{/if}}
                    {{#if details}}<li><strong>Details:</strong> {{details}}</li>{{/if}}
                </ul>
            </div>
        {{/if}}

    </div>
    {{/if}}
    {{#if hasSectionContent}}
        <div class="section-content">

            <!-- ACTIONS -->
            {{#if action}}
                <p>{{#if actionlabel}}{{actionlabel}} {{/if}}{{action}}</p>
            {{/if}}

            <!-- INJURY BUTTON -->
            {{#if injurybutton}}
                {{#each injurybutton}}
                    <button id="cards-button-cardsdark" class="category-button" style="text-align: left; width: 100%; display: flex; justify-content: flex-start; align-items: center;" value="{{this.category}}"><i class="fa-solid {{this.buttonicon}}"></i>{{this.category}}</button>
                {{/each}}
            {{/if}}

            <!-- INJURY BUTTON -->
            {{#if arreffect}}
                <!-- Reply Button -->
                <button id="cards-button-cardsdark" title="Apply this injury as a status effect to the targeted token..." class="coffee-pub-bibliosoph-button-injury" data-effect="{{arreffect}}" style="width: 100%;"><i class="fa-solid {{iconStyle}}"></i>{{buttontext}}</button>
            {{/if}}

            <!-- APPLY CRITICAL / FUMBLE BUTTON -->
            {{#if applyoutcome}}
                <button id="cards-button-cardsdark" title="Apply this result as a status effect to the targeted token..." class="coffee-pub-bibliosoph-button-apply-outcome" data-effect="{{applyoutcome}}" style="width: 100%;"><i class="fa-solid {{applyoutcomeicon}}"></i>{{applyoutcomelabel}}</button>
            {{/if}}

            <!-- CHECK-UP: ZONED TREATMENT ROWS -->
            {{#if treatmentgroups}}
                {{#each treatmentgroups}}
                    <p style="margin: 10px 0 2px 0; text-transform: uppercase; font-size: 0.82em; letter-spacing: 0.5px; opacity: 0.8; border-bottom: 1px solid rgba(0,0,0,0.25);">{{this.label}}</p>
                    {{#each this.rows}}
                        <div style="display: flex; flex-wrap: nowrap; gap: 8px; align-items: center; margin: 4px 0; min-height: 40px;">
                            <span class="coffee-pub-bibliosoph-affliction-icon" data-tooltip="{{this.tooltip}}" data-tooltip-direction="LEFT" data-source="{{this.sourceUuid}}" style="flex: 0 0 40px; width: 40px; height: 40px; box-sizing: border-box; border: 1px solid rgba(0,0,0,0.1); border-radius: 4px; background: rgba(0,0,0,0.5); cursor: help; display: flex; align-items: center; justify-content: center; overflow: hidden;"><img src="{{this.img}}" alt="" style="width: 100%; height: 100%; object-fit: cover; border: none; margin: 0; border-radius: 3px;" /></span>
                            <div style="flex: 1; min-width: 0;">
                                <p style="margin: 0; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><strong>{{this.name}}</strong></p>
                                {{#if this.detail}}<p style="margin: 0; font-size: 0.85em; opacity: 0.8; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{this.detail}}</p>{{/if}}
                            </div>
                            <button id="cards-button-cardsdark" title="Treat: remove this affliction and unwind its condition" class="coffee-pub-bibliosoph-button-treat" data-treat="{{this.payload}}" data-kind="{{this.kind}}" style="flex: 0 0 auto; width: 40px; height: 40px; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center;"><i class="fa-solid {{this.buttonIcon}}" style="margin: 0;"></i></button>
                        </div>
                    {{/each}}
                {{/each}}
            {{/if}}

            <!-- PRIVATE MESSAGE -->
            {{#if arrPrivateRecipients}}
                <!-- Reply Button -->
                <button id="cards-button-cardsdark" title="Reply to this message..." class="coffee-pub-bibliosoph-button-reply" data-recipient="{{strRecipients}}" style="width: 100%;"><i class="fa-solid fa-circle-up"></i>Reply All</button>
            {{/if}}
        </div>
    {{/if}}
    {{/if}}
</div>


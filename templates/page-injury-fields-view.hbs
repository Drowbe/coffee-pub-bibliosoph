<section class="bibliosoph-injury-page-fields">
    {{#if system.image}}
        <img class="injury-page-image" src="{{system.image}}" alt="{{document.name}}">
        {{#if system.imagetitle}}
            <p class="injury-page-caption">{{system.imagetitle}}</p>
        {{/if}}
    {{/if}}

    {{#if system.description}}
        <p class="injury-page-description">{{system.description}}</p>
    {{/if}}

    {{#if system.treatment}}
        <div class="injury-page-treatment">
            <span class="injury-page-label"><i class="fa-solid fa-heart-pulse"></i> Treatment</span>
            <p>{{system.treatment}}</p>
        </div>
    {{/if}}

    <div class="injury-page-meta">
        <div class="injury-page-field">
            <span class="injury-page-label">Damage Type</span>
            <span class="injury-page-value">{{categoryLabel}}</span>
        </div>
        <div class="injury-page-field">
            <span class="injury-page-label">Severity</span>
            <span class="injury-page-value">{{severityLabel}}</span>
        </div>
        <div class="injury-page-field">
            <span class="injury-page-label">Damage</span>
            <span class="injury-page-value">{{system.damage}} hit points</span>
        </div>
        <div class="injury-page-field">
            <span class="injury-page-label">Duration</span>
            <span class="injury-page-value">{{durationLabel}}</span>
        </div>
        <div class="injury-page-field">
            <span class="injury-page-label">Condition</span>
            <span class="injury-page-value">{{conditionLabel}}</span>
        </div>
        <div class="injury-page-field">
            <span class="injury-page-label">Treatment DC</span>
            <span class="injury-page-value">{{treatmentDC}}</span>
        </div>
        <div class="injury-page-field">
            <span class="injury-page-label">Odds</span>
            <span class="injury-page-value">{{system.odds}} of 100</span>
        </div>
    </div>

    {{#if system.gmnotes}}
        <div class="injury-page-guidance">
            <span class="injury-page-label"><i class="fa-solid fa-masks-theater"></i> Running This Injury</span>
            <p>{{system.gmnotes}}</p>
        </div>
    {{/if}}

    {{!-- Blacksmith's GM Notes: the GM's OWN notes on this page, nothing
          of ours. Our guidance above is ordinary injury data. --}}
    {{#if isGM}}
        <section class="bibliosoph-gm-notes-host" data-gm-notes-host aria-label="GM Notes"></section>
    {{/if}}

    {{#if hasDetails}}
        <div class="injury-page-notes-header">
            <i class="fa-solid fa-scroll"></i> Extended Description
        </div>
    {{/if}}
    <hr class="injury-page-divider">
</section>

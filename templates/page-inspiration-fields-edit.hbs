<section class="bibliosoph-inspiration-page-fields bibliosoph-inspiration-page-edit">
    <div class="inspiration-edit-section-header">
        <i class="fa-solid fa-lightbulb"></i>
        <span>Inspiration Card</span>
    </div>

    {{#if warnings.length}}
        <div class="inspiration-edit-warnings">
            {{#each warnings}}<p><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>{{/each}}
        </div>
    {{/if}}

    <p class="inspiration-edit-hint">The page title is the card's name. Drawing a card grants an inspiration point; using the card spends it.</p>

    <div class="form-group inspiration-edit-full">
        <label for="{{document.id}}-insp-image">Image</label>
        <file-picker id="{{document.id}}-insp-image" name="system.image" type="image" value="{{system.image}}"
            placeholder="icons/sundries/gaming/dice-runed-brown.webp"></file-picker>
    </div>

    <div class="form-group inspiration-edit-full">
        <label for="{{document.id}}-insp-caption">Caption</label>
        <input type="text" id="{{document.id}}-insp-caption" name="system.imagetitle" value="{{system.imagetitle}}"
            placeholder="A short evocative line shown under the art">
    </div>

    <div class="form-group inspiration-edit-full">
        <label for="{{document.id}}-insp-description">Description</label>
        <textarea id="{{document.id}}-insp-description" name="system.description" rows="4"
            placeholder="What the card lets them do. Inline rolls like [[1d10]] work here.">{{system.description}}</textarea>
    </div>

    <div class="inspiration-edit-section-header">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        <span>Automation</span>
    </div>
    <p class="inspiration-edit-hint">Only pick an action for cards that are a plain state change. Anything needing a decision should stay narrative — a button that guesses is worse than no button.</p>

    <div class="inspiration-edit-grid">
        <div class="form-group">
            <label for="{{document.id}}-insp-action">Action</label>
            <select id="{{document.id}}-insp-action" name="system.action">
                {{#each actionChoices}}
                    <option value="{{this.value}}" {{#if (eq this.value ../system.action)}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
            </select>
        </div>
        <div class="form-group">
            <label for="{{document.id}}-insp-amount">Hit points {{#unless showAmount}}<span class="inspiration-edit-note">(used by "Set hit points")</span>{{/unless}}</label>
            <input type="number" id="{{document.id}}-insp-amount" name="system.actionamount" value="{{system.actionamount}}" min="0" step="1">
        </div>
        <div class="form-group">
            <label for="{{document.id}}-insp-formula">Formula {{#unless showFormula}}<span class="inspiration-edit-note">(used by "percentage")</span>{{/unless}}</label>
            <input type="text" id="{{document.id}}-insp-formula" name="system.actionformula" value="{{system.actionformula}}" placeholder="1d10*10">
        </div>
        <div class="form-group">
            <label for="{{document.id}}-insp-odds">Odds (1–100)</label>
            <input type="number" id="{{document.id}}-insp-odds" name="system.odds" value="{{system.odds}}" min="1" max="100" step="1">
        </div>
    </div>

    <div class="inspiration-edit-section-header">
        <i class="fa-solid fa-masks-theater"></i>
        <span>Running This Card</span>
    </div>
    <div class="form-group inspiration-edit-full">
        <textarea id="{{document.id}}-insp-gmnotes" name="system.gmnotes" rows="4"
            placeholder="How to run it at the table, and a line to say out loud.">{{system.gmnotes}}</textarea>
        <p class="inspiration-edit-hint">Ships with the card and updates when it does.</p>
    </div>

    <section class="bibliosoph-gm-notes-host" data-gm-notes-host aria-label="GM Notes"></section>

    <div class="inspiration-edit-section-header">
        <i class="fa-solid fa-scroll"></i>
        <span>Extended Description</span>
    </div>
    <p class="inspiration-edit-hint">Optional rich text shown on this page below the fields.</p>
</section>

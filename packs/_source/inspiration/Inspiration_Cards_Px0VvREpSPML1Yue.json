    {
      "type": "coffee-pub-bibliosoph.inspiration",
      "name": "Deep Thought",
      "text": {
        "content": "",
        "format": 1
      },
      "_id": "iJrcamaodMc6atbW",
      "system": {
        "image": "icons/skills/wounds/anatomy-organ-brain-pink-red.webp",
        "imagetitle": "Just This Once",
        "description": "Concentrate. Think deep thoughts. Just this once you can know a thing. Anything.",
        "odds": 10,
        "action": "none",
        "actionamount": null,
        "actionformula": "",
        "gmnotes": "Answer honestly and completely — this card is worthless if you hedge. If the answer would derail the campaign, that is a sign the answer matters. Stinger: \"Ask.\""
      },
      "title": {
        "show": true,
        "level": 1
      },
